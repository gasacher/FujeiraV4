# Hostinger: the site can live inside public_html. Laravel stays in this folder.
DirectoryIndex index.php

<FilesMatch "^\.env($|\.)|^config-mp\.local\.php$|^composer\.(json|lock)$|^artisan$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^(app|bootstrap|config|database|legacy|resources|routes|storage|tests|vendor)(/|$) - [F,L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.php [L]
</IfModule>
