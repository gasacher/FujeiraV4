# Hostinger: the site can live inside public_html. Laravel stays in this folder.
DirectoryIndex index.php

<FilesMatch "^\.env($|\.)|^config-mp\.local\.php$|^composer\.(json|lock)$|^artisan$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^(app|bootstrap|config|database|legacy|resources|routes|storage|tests|vendor)(/|$) - [F,L]

  # Old static shop. These rules run before a leftover file can be served.
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteRule ^catalogo\.html$ /catalogo [R=301,L]
  RewriteRule ^nosotros\.html$ /nosotros [R=301,L]
  RewriteRule ^faqs\.html$ /faqs [R=301,L]
  RewriteRule ^contacto\.html$ /contacto [R=301,L]
  RewriteRule ^pago-exitoso\.html$ /pago/exitoso [R=301,L]
  RewriteRule ^pago-pendiente\.html$ /pago/pendiente [R=301,L]
  RewriteRule ^pago-fallido\.html$ /pago/fallido [R=301,L]
  RewriteRule ^producto\.html$ index.php [L]
  RewriteRule ^api/crear-preferencia\.php$ - [G,L]
  RewriteRule ^data/.+\.json$ - [F,L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.php [L]
</IfModule>
